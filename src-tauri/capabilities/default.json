{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "http:default",
    "global-shortcut:default",
    "keyring:allow-get-password",
    "keyring:allow-set-password",
    "keyring:allow-delete-password"
  ]
}
